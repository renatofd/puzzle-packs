{
  "name": "puzzle-packs",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Puzzle Packs: incremental de rasgar pacotes de cartas que são peças de quebra-cabeça. Feito sobre o incremental-kit (PixiJS v8, 100% canvas).",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "sim": "vite-node tools/simulate.ts",
    "sim:node-breaker": "vite-node tools/simulate-node-breaker.ts",
    "build:portal": "npm run build && vite-node tools/zip.ts",
    "build:poki": "tsc --noEmit && vite build --mode poki && vite-node tools/zip.ts -- puzzlepacks-poki.zip",
    "dev:poki": "vite --mode poki"
  },
  "dependencies": {
    "break_eternity.js": "^2.1.3",
    "pixi.js": "^8.22.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "typescript": "^7.0.2",
    "vite": "^8.3.3",
    "vite-node": "^6.0.0",
    "vitest": "^5.0.3"
  }
}
